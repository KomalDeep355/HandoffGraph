# ---- target repo (the "company") ----
TARGET_REPO=fastapi/fastapi
SRC_PREFIXES=fastapi/
SRC_EXTS=.py
MODULE_DEPTH=2
HALF_LIFE_DAYS=365
ACTIVE_DAYS=365

# ---- FalkorDB ----
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# ---- LLM (any OpenAI-compatible endpoint). Leave LLM_API_KEY empty => offline planner ----
# Gemini (free key from aistudio.google.com):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# Local Ollama instead:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# ---- optional action: open real GitHub issues in YOUR OWN sandbox repo (never the target repo) ----
# Issue creation stays in dry-run mode unless explicitly enabled here and opted into in the UI.
GITHUB_ISSUES_ENABLED=false
GITHUB_TOKEN=
GITHUB_ISSUE_REPO=
